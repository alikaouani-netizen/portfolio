# Copier ce fichier en ".env" et renseigner des valeurs réelles.
# Ne JAMAIS committer le fichier ".env" (il doit rester local au VPS).

# --- Domaine ---
MOODLE_DOMAIN=campus.educsante.academy
LETSENCRYPT_EMAIL=admin@educsante.academy

# --- Base de données MariaDB ---
MARIADB_ROOT_PASSWORD=change_me_root_password
MARIADB_DATABASE=moodle
MARIADB_USER=moodle
MARIADB_PASSWORD=change_me_moodle_db_password

# --- Compte administrateur Moodle (créé à la première installation) ---
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=change_me_admin_password
MOODLE_ADMIN_EMAIL=admin@educsante.academy
MOODLE_SITE_NAME=EducSanté Academy - Campus

# --- SMTP (envoi des emails Moodle : inscriptions, notifications, mot de passe) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=smtp-user
SMTP_PASSWORD=change_me_smtp_password
SMTP_PROTOCOL=tls

# --- Redis (cache de session, optionnel mais recommandé) ---
REDIS_PASSWORD=change_me_redis_password

# --- Sauvegardes ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7
